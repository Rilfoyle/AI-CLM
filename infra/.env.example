# Local-only CLM runtime settings. Copy to infra/.env and replace both secrets.
CLM_DB_PASSWORD=replace-with-a-local-database-password
CLM_DB_USERNAME=root
CLM_DB_URL=jdbc:mysql://127.0.0.1:3306/ruoyi-vue-pro?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&nullCatalogMeansCurrent=true&rewriteBatchedStatements=true
CLM_REDIS_HOST=127.0.0.1
CLM_REDIS_PORT=6379
CLM_ONLYOFFICE_ENABLED=true
CLM_ONLYOFFICE_URL=http://127.0.0.1:8090
CLM_ONLYOFFICE_CALLBACK_BASE=http://host.docker.internal:48080
CLM_ONLYOFFICE_JWT_SECRET=replace-with-a-long-random-local-secret
